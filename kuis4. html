        { q: "Apa risiko utama menggunakan taktik 'Black Hat SEO' untuk meningkatkan peringkat website?", options: ["Biaya yang sangat mahal", "Website dapat terkena penalti dan dihapus dari indeks mesin pencari (Google)", "Desain website akan rusak", "Hanya akan menarik pengguna dari luar negeri"], ans: 1 },
        { q: "Analisis PESTLE biasanya digunakan untuk...", options: ["Mengedit video untuk Instagram", "Menganalisis faktor eksternal (Politik, Ekonomi, Sosial, Teknologi, Hukum, Lingkungan) sebelum meluncurkan strategi pemasaran besar", "Menghitung jumlah karakter di Twitter", "Mencari alamat email prospek"], ans: 1 },
        { q: "Dalam funnel pemasaran konvensional maupun digital, tahap AIDA terdiri dari...", options: ["Action, Interaction, Direction, Activation", "Awareness, Interest, Desire, Action", "Always, Into, Data, Analytics", "Attention, Internet, Digital, Ads"], ans: 1 }
    ];

    // Variabel state kuis
    let currentQuestion = 0;
    let userAnswers = new Array(quizData.length).fill(null);
    let isQuizActive = false;
    let userData = { name: "", absen: "", kelas: "" };

    // --- FUNGSI NAVIGASI LAYAR ---
    function showScreen(screenId) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(screenId).classList.add('active');
    }

    // --- MEMULAI KUIS ---
    function startQuiz(e) {
        e.preventDefault();
        
        userData.absen = document.getElementById('no_absen').value;
        userData.name = document.getElementById('nama').value;
        userData.kelas = document.getElementById('kelas').value;

        isQuizActive = true;
        requestWakeLock(); // Aktifkan anti layar mati
        
        showScreen('quiz-screen');
        renderQuestion();
    }

    // --- DETEKSI KECURANGAN (TAB PINDAH) ---
    document.addEventListener("visibilitychange", function() {
        // Jika sedang ujian dan tab disembunyikan/pindah aplikasi
        if (document.visibilityState === 'hidden' && isQuizActive) {
            alert("PELANGGARAN: Anda terdeteksi keluar dari halaman kuis/berpindah aplikasi!\n\nKuis otomatis dihentikan dan nilai saat ini akan langsung dikirim.");
            isQuizActive = false; // Mencegah trigger berulang
            submitQuiz(); // Kirim secara paksa
        }
    });

    // --- RENDER SOAL ---
    function renderQuestion() {
        const qData = quizData[currentQuestion];
        
        document.getElementById('q-counter').innerText = `Soal ${currentQuestion + 1} / ${quizData.length}`;
        document.getElementById('question-text').innerText = qData.q;
        
        const optionsList = document.getElementById('options-list');
        optionsList.innerHTML = '';

        qData.options.forEach((opt, index) => {
            const btn = document.createElement('div');
            btn.className = 'option-item';
            // Tandai jika sudah pernah dipilih
            if (userAnswers[currentQuestion] === index) {
                btn.classList.add('selected');
            }
            btn.innerText = String.fromCharCode(65 + index) + ". " + opt;
            btn.onclick = () => selectOption(index);
            optionsList.appendChild(btn);
        });

        // Atur tombol prev & next
        document.getElementById('btn-prev').disabled = currentQuestion === 0;
        
        const btnNext = document.getElementById('btn-next');
        if (currentQuestion === quizData.length - 1) {
            btnNext.innerText = 'Selesai & Kirim';
            btnNext.style.backgroundColor = 'var(--success)';
        } else {
            btnNext.innerText = 'Selanjutnya';
            btnNext.style.backgroundColor = 'var(--primary)';
        }
    }

    // --- PILIH JAWABAN ---
    function selectOption(index) {
        userAnswers[currentQuestion] = index;
        renderQuestion(); // Re-render untuk efek visual selected
    }

    // --- NAVIGASI SOAL ---
    function prevQuestion() {
        if (currentQuestion > 0) {
            currentQuestion--;
            renderQuestion();
        }
    }

    function nextQuestion() {
        // Harus jawab dulu sebelum next
        if (userAnswers[currentQuestion] === null) {
            alert('Silakan pilih salah satu jawaban sebelum melanjutkan!');
            return;
        }

        if (currentQuestion < quizData.length - 1) {
            currentQuestion++;
            renderQuestion();
        } else {
            // Jika ini soal terakhir
            if (confirm("Apakah Anda yakin telah selesai dan ingin mengirim jawaban?")) {
                isQuizActive = false; // Akhiri pengawasan cheat sementara loading
                submitQuiz();
            }
        }
    }

    // --- MENGHITUNG SKOR & KIRIM KE GOOGLE SCRIPT ---
    function submitQuiz() {
        showScreen('loading-screen');
        releaseWakeLock(); // Lepaskan wake lock karena kuis selesai

        let score = 0;
        for (let i = 0; i < quizData.length; i++) {
            if (userAnswers[i] === quizData[i].ans) {
                score++;
            }
        }

        const totalQuestions = quizData.length;
        
        // PAYLOAD WAJIB Sesuai Persyaratan di Prompt
        const payload = {
            "quizTitle": "Kuis Strategi Pemasaran Konvensional dan Digital",
            "name": userData.name + " (" + userData.absen + ")", // Menyelipkan absen di nama agar terdata
            "kelas": userData.kelas,
            "score": score,
            "totalQuestions": totalQuestions
        };

        // Kirim menggunakan Fetch API POST mode no-cors
        fetch(GOOGLE_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(() => {
            // Karena no-cors, response tidak bisa dibaca isinya (opaque). 
            // Namun jika sampai di blok 'then', berarti request berhasil terkirim.
            showResult(score, totalQuestions, true);
        })
        .catch(error => {
            console.error('Error:', error);
            showResult(score, totalQuestions, false);
        });
    }

    // --- TAMPILKAN HASIL AKHIR ---
    function showResult(score, total, isSuccess) {
        showScreen('result-screen');
        
        const finalGrade = Math.round((score / total) * 100);
        document.getElementById('final-score').innerText = finalGrade;
        document.getElementById('correct-count').innerText = score;

        const msgEl = document.getElementById('result-message');
        if (isSuccess) {
            msgEl.innerText = "Terima kasih, data jawaban Anda berhasil dikirim ke server dan tercatat.";
            msgEl.style.color = "var(--success)";
        } else {
            msgEl.innerText = "Jawaban dievaluasi, tetapi ada masalah pada koneksi saat mengirim data. Silakan lapor ke admin.";
            msgEl.style.color = "var(--danger)";
        }
    }
</script>

</body>
</html>
