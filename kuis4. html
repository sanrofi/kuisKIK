<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kuis Interaktif: Pemasaran Konvensional dan Digital</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --success: #10B981;
            --danger: #ef4444;
            --background: #f3f4f6;
            --card-bg: #ffffff;
            --text-main: #1f2937;
            --text-muted: #6b7280;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            background-color: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 800px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .header {
            background-color: var(--primary);
            color: white;
            padding: 20px;
            text-align: center;
        }

        .header h1 {
            font-size: 1.5rem;
            margin-bottom: 5px;
        }

        .content {
            padding: 30px;
        }

        .screen {
            display: none;
        }

        .screen.active {
            display: block;
            animation: fadeIn 0.4s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Material Content */
        .material-box {
            background-color: #f8fafc;
            border-left: 4px solid var(--primary);
            padding: 15px;
            margin-bottom: 20px;
            font-size: 0.95rem;
            line-height: 1.6;
            max-height: 300px;
            overflow-y: auto;
        }

        .material-box h3 {
            margin-bottom: 10px;
            color: var(--primary);
        }

        /* Form */
        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 1rem;
        }

        .warning-box {
            background-color: #fef2f2;
            color: var(--danger);
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #f87171;
            margin-bottom: 20px;
            font-size: 0.9rem;
            font-weight: bold;
        }

        /* Buttons */
        .btn {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            width: 100%;
        }

        .btn:hover { background-color: var(--primary-hover); }
        .btn:disabled { background-color: #9ca3af; cursor: not-allowed; }
        
        .btn-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-top: 20px;
        }

        /* Quiz Specifics */
        .question-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 0.9rem;
            color: var(--text-muted);
            font-weight: 600;
        }

        .question-text {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 20px;
            line-height: 1.4;
        }

        .options-list {
            list-style: none;
        }

        .option-item {
            display: block;
            padding: 15px;
            margin-bottom: 10px;
            background-color: #f9fafb;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .option-item:hover {
            border-color: var(--primary);
            background-color: #eff6ff;
        }

        .option-item.selected {
            border-color: var(--primary);
            background-color: #dbeafe;
            font-weight: bold;
        }

        /* Loading & Results */
        .loading {
            text-align: center;
            font-style: italic;
            color: var(--text-muted);
        }

        .result-box {
            text-align: center;
        }

        .result-box h2 { margin-bottom: 10px; }
        .result-box p { font-size: 1.1rem; margin-bottom: 25px; }
        .score-circle {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background-color: var(--success);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            margin: 0 auto 20px auto;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>Kuis Strategi Pemasaran</h1>
        <p>Konvensional & Digital</p>
    </div>

    <div class="content">
        <!-- 1. MATERIAL SCREEN -->
        <div id="material-screen" class="screen active">
            <h2>Materi Pengantar</h2>
            <div class="material-box">
                <h3>Pemasaran Konvensional vs Digital</h3>
                <p><strong>Pemasaran Konvensional</strong> adalah strategi pemasaran yang menggunakan saluran tradisional seperti media cetak (koran, brosur), siaran (TV, Radio), direct mail, dan telemarketing. Pendekatan ini jangkauannya luas namun sulit untuk diukur tingkat konversinya secara presisi.</p>
                <br>
                <p><strong>Pemasaran Digital</strong> memanfaatkan internet dan teknologi digital seperti Search Engine Optimization (SEO), Media Sosial (Instagram, TikTok, Facebook), Email Marketing, dan Pay-Per-Click (PPC). Keunggulannya adalah target audiens yang lebih spesifik, biaya yang bisa disesuaikan, dan hasil yang dapat diukur secara real-time melalui analytics.</p>
                <br>
                <p>Memahami kedua strategi ini penting bagi bisnis untuk menciptakan pendekatan <em>omnichannel</em> yang menyeluruh. Silakan pahami konsep dasar, kelebihan, serta metrik pengukurannya sebelum memulai kuis ini.</p>
            </div>
            <button class="btn" onclick="showScreen('start-screen')">Saya Sudah Paham, Lanjut ke Pendaftaran</button>
        </div>

        <!-- 2. START SCREEN (FORM) -->
        <div id="start-screen" class="screen">
            <div class="warning-box">
                ⚠️ PERINGATAN: Kuis ini dilengkapi sistem Anti-Kecurangan. Jangan keluar atau berpindah tab/aplikasi saat kuis berlangsung. Jika terdeteksi keluar dari halaman kuis, kuis akan otomatis dihentikan dan nilai saat itu akan langsung dikirim!
            </div>
            <form id="registration-form" onsubmit="startQuiz(event)">
                <div class="form-group">
                    <label for="no_absen">Nomor Absen</label>
                    <input type="number" id="no_absen" class="form-control" required placeholder="Contoh: 12">
                </div>
                <div class="form-group">
                    <label for="nama">Nama Lengkap</label>
                    <input type="text" id="nama" class="form-control" required placeholder="Masukkan nama lengkap">
                </div>
                <div class="form-group">
                    <label for="kelas">Kelas / Rombel</label>
                    <select id="kelas" class="form-control" required>
                        <option value="" disabled selected>-- Pilih Kelas --</option>
                        <option value="XI A AKL">XI A AKL</option>
                        <option value="XI B AKL">XI B AKL</option>
                        <option value="XI C AKL">XI C AKL</option>
                        <option value="XI D AKL">XI D AKL</option>
                        <option value="XI B PMS">XI B PMS</option>
                        <option value="XII B PMS">XII B PMS</option>
                        <option value="XII A AKL">XII A AKL</option>
                        <option value="XII B AKL">XII B AKL</option>
                        <option value="XII C AKL">XII C AKL</option>
                    </select>
                </div>
                <button type="submit" class="btn">Mulai Kuis Sekarang</button>
            </form>
        </div>

        <!-- 3. QUIZ SCREEN -->
        <div id="quiz-screen" class="screen">
            <div class="question-header">
                <span id="q-counter">Soal 1 / 50</span>
                <span>Jangan tutup tab ini!</span>
            </div>
            <div id="question-text" class="question-text">Memuat pertanyaan...</div>
            <div class="options-list" id="options-list">
                <!-- Pilihan jawaban di-render via JS -->
            </div>
            
            <div class="btn-row">
                <button id="btn-prev" class="btn" style="background-color: var(--text-muted);" onclick="prevQuestion()">Sebelumnya</button>
                <button id="btn-next" class="btn" onclick="nextQuestion()">Selanjutnya</button>
            </div>
        </div>

        <!-- SUBMIT SCREEN (LOADING) -->
        <div id="loading-screen" class="screen">
            <div class="loading">
                <h2 style="margin-bottom:10px;">Menyimpan Jawaban...</h2>
                <p>Harap tunggu, data sedang dikirim ke server.</p>
            </div>
        </div>

        <!-- 4. RESULT SCREEN -->
        <div id="result-screen" class="screen">
            <div class="result-box">
                <h2>Kuis Selesai!</h2>
                <p id="result-message">Terima kasih, data Anda telah tersimpan.</p>
                <div class="score-circle" id="final-score">0</div>
                <p>Jawaban Benar: <span id="correct-count">0</span> dari 50 Soal</p>
                <button class="btn" onclick="location.reload()" style="margin-top: 15px;">Coba Lagi</button>
            </div>
        </div>

    </div>
</div>

<script>
    // --- KONFIGURASI BACKEND ---
    const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxo8Ibe0QaBUnLB36eEG6qPB1K8ztfR9sojoL2zuxiBbNypXzGh8JtLxe_WJYDSck9LMA/exec";

    // --- WAKE LOCK API (Menjaga layar tetap menyala) ---
    let wakeLock = null;
    const requestWakeLock = async () => {
        try {
            if ('wakeLock' in navigator) {
                wakeLock = await navigator.wakeLock.request('screen');
                console.log('Screen Wake Lock aktif.');
            }
        } catch (err) {
            console.error(`${err.name}, ${err.message}`);
        }
    };

    const releaseWakeLock = async () => {
        if (wakeLock !== null) {
            await wakeLock.release();
            wakeLock = null;
            console.log('Screen Wake Lock dimatikan.');
        }
    };

    // Re-acquire wake lock if visibility changes but quiz is active
    document.addEventListener('visibilitychange', async () => {
        if (wakeLock !== null && document.visibilityState === 'visible') {
            requestWakeLock();
        }
    });

